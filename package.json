{
  "name": "code-shamer",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "YOUR_PUBLISHER_ID",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlymech/code-shamer"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "code quality",
    "linter",
    "shame",
    "bad patterns",
    "code review",
    "fun"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-shamer.scanWorkspace",
        "title": "%command.scanWorkspace.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "code-shamer.showPanel",
        "title": "%command.showPanel.title%"
      },
      {
        "command": "code-shamer.clearCache",
        "title": "%command.clearCache.title%"
      },
      {
        "command": "code-shamer.disableRuleWorkspace",
        "title": "%command.disableRuleWorkspace.title%"
      },
      {
        "command": "code-shamer.scanCurrentFile",
        "title": "%command.scanCurrentFile.title%",
        "icon": {
          "light": "media/codeshamer-activity.svg",
          "dark": "media/codeshamer-activity.svg"
        }
      },
      {
        "command": "code-shamer.reviewFixes",
        "title": "%command.reviewFixes.title%",
        "icon": "$(wand)"
      },
      {
        "command": "code-shamer.scanning",
        "title": "%command.scanning.title%",
        "icon": "$(sync~spin)"
      },
      {
        "command": "code-shamer.showFileShames",
        "title": "%command.showFileShames.title%",
        "icon": "$(flame)"
      },
      {
        "command": "code-shamer.applyFixInline",
        "title": "%command.applyFixInline.title%"
      },
      {
        "command": "code-shamer.ignoreInline",
        "title": "%command.ignoreInline.title%"
      },
      {
        "command": "code-shamer.ignoreFileFromDiff",
        "title": "%command.ignoreFileFromDiff.title%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "code-shamer.applySuggestionAtCursor",
        "title": "%command.applySuggestionAtCursor.title%",
        "icon": "$(check)"
      },
      {
        "command": "code-shamer.applyAllSuggestionsInFile",
        "title": "%command.applyAllSuggestionsInFile.title%",
        "icon": "$(check-all)"
      },
      {
        "command": "code-shamer.ignoreSuggestionAtCursor",
        "title": "%command.ignoreSuggestionAtCursor.title%",
        "icon": "$(eye-closed)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeshamer",
          "title": "%viewsContainers.codeshamer.title%",
          "icon": "media/codeshamer-activity.svg"
        }
      ]
    },
    "views": {
      "codeshamer": [
        {
          "type": "tree",
          "id": "codeshamer.treeView",
          "name": "%views.codeshamer.treeView.name%",
          "icon": "media/codeshamer-activity.svg"
        },
        {
          "type": "webview",
          "id": "codeshamer.panelView",
          "name": "%views.codeshamer.panelView.name%",
          "icon": "media/codeshamer-activity.svg"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "code-shamer.reviewFixes",
          "when": "view == codeshamer.treeView && viewItem == shameFile",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "code-shamer.ignoreFileFromDiff",
          "group": "navigation",
          "when": "resourceScheme == codeshamer-fix"
        },
        {
          "command": "code-shamer.applySuggestionAtCursor",
          "group": "navigation@1",
          "when": "resourceScheme == codeshamer-fix"
        },
        {
          "command": "code-shamer.applyAllSuggestionsInFile",
          "group": "navigation@2",
          "when": "resourceScheme == codeshamer-fix"
        },
        {
          "command": "code-shamer.scanCurrentFile",
          "group": "navigation",
          "when": "resourceLangId =~ /(javascript|javascriptreact|typescript|typescriptreact|python|java|dart|php|html|css|c|cpp)/ && codeShamer.fileState != 'shames' && !codeShamer.isScanning"
        },
        {
          "command": "code-shamer.scanning",
          "group": "navigation",
          "when": "resourceLangId =~ /(javascript|javascriptreact|typescript|typescriptreact|python|java|dart|php|html|css|c|cpp)/ && codeShamer.isScanning"
        },
        {
          "command": "code-shamer.showFileShames",
          "group": "navigation",
          "when": "resourceLangId =~ /(javascript|javascriptreact|typescript|typescriptreact|python|java|dart|php|html|css|c|cpp)/ && codeShamer.fileState == 'shames' && !codeShamer.isScanning && !isInDiffEditor"
        }
      ],
      "view/title": [
        {
          "command": "code-shamer.scanWorkspace",
          "when": "view == codeshamer.treeView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "codeShamer.enable": {
          "type": "boolean",
          "default": true,
          "description": "%config.enable.description%"
        },
        "codeShamer.enableRoasts": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableRoasts.description%"
        },
        "codeShamer.showStartupNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStartupNotifications.description%"
        },
        "codeShamer.showAchievementNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.showAchievementNotifications.description%"
        },
        "codeShamer.showScanCompletionStatusMessage": {
          "type": "boolean",
          "default": true,
          "description": "%config.showScanCompletionStatusMessage.description%"
        },
        "codeShamer.showStatusBarOnlyWhileScanning": {
          "type": "boolean",
          "default": false,
          "description": "%config.showStatusBarOnlyWhileScanning.description%"
        },
        "codeShamer.enabledLanguages": {
          "type": "array",
          "default": [
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "python",
            "java",
            "cpp",
            "c",
            "dart",
            "php",
            "html",
            "css"
          ],
          "description": "%config.enabledLanguages.description%"
        },
        "codeShamer.severityThreshold": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "%config.severityThreshold.description%"
        },
        "codeShamer.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/vendor/**",
            "**/.pnp/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.output/**",
            "**/.vercel/**",
            "**/.netlify/**",
            "**/.astro/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/.svelte-kit/**",
            "**/.remix/**",
            "**/.solid/**",
            "**/.expo/**",
            "**/.angular/**",
            "**/.gatsby/**",
            "**/.docusaurus/**",
            "**/.cache/**",
            "**/.turbo/**",
            "**/.parcel-cache/**",
            "**/.vite/**",
            "**/.esbuild/**",
            "**/.webpack/**",
            "**/coverage/**",
            "**/.nyc_output/**",
            "**/.git/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/.claude/**",
            "**/.cursor/**",
            "**/.idea/**",
            "**/.vscode-test/**",
            "**/.devcontainer/**",
            "**/*.min.js",
            "**/*.min.css",
            "**/.terraform/**",
            "**/__pycache__/**",
            "**/.pytest_cache/**",
            "**/.mypy_cache/**",
            "**/.ruff_cache/**",
            "**/.tox/**"
          ],
          "description": "%config.excludePatterns.description%"
        },
        "codeShamer.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.scanOnSave.description%"
        },
        "codeShamer.scanOnEdit": {
          "type": "boolean",
          "default": true,
          "description": "%config.scanOnEdit.description%"
        },
        "codeShamer.maxFilesToScan": {
          "type": "number",
          "default": 5000,
          "description": "%config.maxFilesToScan.description%"
        },
        "codeShamer.disabledRules": {
          "type": "array",
          "default": [],
          "description": "%config.disabledRules.description%"
        },
        "codeShamer.inlineShameUnderlineColors": {
          "type": "object",
          "default": {
            "1": "#E5C07B",
            "2": "#E5B567",
            "3": "#E59F5A",
            "4": "#E06C75",
            "5": "#BE5046"
          },
          "description": "%config.inlineShameUnderlineColors.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
